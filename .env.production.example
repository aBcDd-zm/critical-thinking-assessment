# 生产环境配置模板：复制为 .env.production 后逐项修改。
# .env.production 含密钥，已被 .gitignore 排除，绝不能提交仓库。

# ── 数据库（compose 会用它拼 DATABASE_URL，无需单独配）──
MYSQL_ROOT_PASSWORD=请改成强密码

# ── 应用 ──
APP_NAME=Critical Thinking Assessment API
APP_ENV=production
API_V1_PREFIX=/api/v1
SQL_ECHO=false

# 前端与后端同源（Nginx 反代 /api），CORS 仅作兜底；换成你的公网地址。
BACKEND_CORS_ORIGINS=["http://你的域名或服务器IP"]

# ── 模型网关 ──
MODEL_PROVIDER=deepseek
MODEL_GATEWAY_MODE=real
CONSULTATIVE_TURN_TIMEOUT_SECONDS=10
RUNTIME_CONSULTATIVE_TURN_TIMEOUT_SECONDS=8
INTERVIEWER_STYLE_ENABLED=false
INTERVIEWER_STYLE_DEFAULT=baseline_v1
INTERVIEWER_RENDER_TIMEOUT_SECONDS=3
RUNTIME_INTERVIEWER_RENDER_TIMEOUT_SECONDS=5
RUNTIME_HUMANISTIC_V11_MODEL_POLISH_MODE=adaptive
DEEPSEEK_API_KEY=sk-请填入真实密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_ENABLE_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# ── 豆包真实语音（TTS V3）──
# 生产示例默认关闭。开启前需开通对应资源，仅填 API Key；任何密钥都不得提交。
TTS_MODE=disabled
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_male_ruyayichen_saturn_bigtts
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_BIT_RATE=128000
DOUBAO_TTS_SPEECH_RATE=-5
DOUBAO_TTS_CONTEXT_TEXT="请像一位成熟、温和、专注的访谈者面对面自然交谈。语气真诚克制，不要播音腔，不要教学腔，不要逐字重读；停顿自然，句尾轻收。"
DOUBAO_TTS_TIMEOUT_SECONDS=25
# 2 次尝试 = 首次请求 + 最多 1 次网络重试。
DOUBAO_TTS_MAX_ATTEMPTS=2
DOUBAO_TTS_RETRY_DELAY_SECONDS=0.25

# ── 豆包真实语音转写（录音文件极速版）──
# 生产示例默认关闭。开启前需开通 volc.bigasr.auc_turbo 资源。
# 可设置独立 ASR Key；留空时后端会复用上方的新版 TTS API Key。
ASR_MODE=disabled
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_TIMEOUT_SECONDS=25
DOUBAO_ASR_MAX_ATTEMPTS=2
DOUBAO_ASR_RETRY_DELAY_SECONDS=0.25
DOUBAO_ASR_CONVERSION_TIMEOUT_SECONDS=12

# ── 管理员（公网部署必须改掉默认值）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
ADMIN_TOKEN_SECRET=请改成至少32位随机字符串
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_TOKEN_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_ENABLED=true
